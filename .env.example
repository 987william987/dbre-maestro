# Copy to .env and fill in real values before starting

# Meta DB password for the app user
MYSQL_APP_PASSWORD=changeme_app

# Meta DB root password (only used during docker compose up)
MYSQL_ROOT_PASSWORD=changeme_root

# 32-byte AES key, base64-encoded. Generate: make gen-key
DBRE_ENCRYPTION_KEY=

# JWT signing secret (any long random string)
JWT_SECRET=

# App port (default 8080)
PORT=8080

# DB pool profiles for external data sources
DB_POOL_QUERY_MAX_OPEN=10
DB_POOL_QUERY_MAX_IDLE=5
DB_POOL_QUERY_CONN_MAX_LIFETIME=5m
DB_POOL_QUERY_CONN_MAX_IDLE_TIME=2m

DB_POOL_EXEC_MAX_OPEN=3
DB_POOL_EXEC_MAX_IDLE=1
DB_POOL_EXEC_CONN_MAX_LIFETIME=5m
DB_POOL_EXEC_CONN_MAX_IDLE_TIME=2m

DB_POOL_METADATA_MAX_OPEN=1
DB_POOL_METADATA_MAX_IDLE=1
DB_POOL_METADATA_CONN_MAX_LIFETIME=2m
DB_POOL_METADATA_CONN_MAX_IDLE_TIME=1m

DB_POOL_SCOPED_PG_QUERY_MAX_OPEN=2
DB_POOL_SCOPED_PG_QUERY_MAX_IDLE=1
DB_POOL_SCOPED_PG_QUERY_CONN_MAX_LIFETIME=2m
DB_POOL_SCOPED_PG_QUERY_CONN_MAX_IDLE_TIME=1m

# If migration needs a different DSN from the app (e.g. root for REVOKE)
# MIGRATION_DSN=root:changeme_root@tcp(localhost:3306)/maestro?parseTime=true&charset=utf8mb4&loc=UTC

# Lark Webhook URL for ticket notifications (optional; leave empty to disable)
# LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/...
